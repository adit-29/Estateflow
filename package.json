{
  "name": "estateflow",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@estateflow/web & npm run dev --workspace=@estateflow/api",
    "dev:web": "npm run dev --workspace=@estateflow/web",
    "dev:api": "npm run dev --workspace=@estateflow/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=@estateflow/api",
    "db:migrate": "npm run db:migrate --workspace=@estateflow/api",
    "db:seed": "npm run db:seed --workspace=@estateflow/api"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9.39.5"
  }
}
