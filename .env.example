# Copy into apps/api/.env for the Nest API.
# For Next.js, copy only the "Web (public)" block into apps/web/.env.local.
# Do not put DATABASE_URL, LOCAL_AUTH_SECRET, or provider tokens in the web env file.
# Runtime environment: local | staging | production. Unset + NODE_ENV=production is treated as production.
# staging/production refuse to start on unsafe settings (see apps/api/src/config/runtime-env.ts).
APP_ENV=local
APP_VERSION=

# Database. Deployed environments must add &sslmode=require.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estateflow?schema=public
# Used by API integration tests when you want them to hit Postgres instead of skipping.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estateflow?schema=public
# Must stay unset/false outside local. Production API startup refuses SEED_DEMO_DATA=true.
SEED_DEMO_DATA=false

# API
API_PORT=4000
# Next.js server-side rewrite target (baked into the web image at docker build time).
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Auth (production: Amazon Cognito — adapter is not implemented yet, so production cannot sign anyone in)
AUTH_PROVIDER=local
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=

# Local dev auth (never use in production)
LOCAL_AUTH_SECRET=change-me-in-development-only
LOCAL_AUTH_TOKEN_TTL_SECONDS=86400
# Password reset for AUTH_PROVIDER=local: hashed codes in LocalAuthCredential.
# APP_ENV=local returns resetCode in JSON. No email is sent. Cognito reset is not implemented.
# Platform admin is Account.platformAdmin in Postgres, not an env var.

# Web (public — no secrets). Baked in at build time.
# Browser calls go to same-origin /backend, which Next rewrites to API_URL.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# production removes the demo workspace, demo credentials, and sample listings from the bundle.
NEXT_PUBLIC_APP_ENV=local
# Unused by current code. Auth mode is read from GET /auth/mode.
NEXT_PUBLIC_AUTH_MODE=local
# Optional homepage media. Leave empty to keep the local poster. No remote video is invented.
NEXT_PUBLIC_HERO_POSTER_URL=
NEXT_PUBLIC_HERO_VIDEO_URL=

# Rate limiting
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_MAX=20

# Messaging providers — placeholders only. Leave empty for local demo mode.
# Never commit real tokens. These are read on the API server, not the browser. See docs/whatsapp.md.
# All four WhatsApp values are required before the inbox can leave "Not connected".
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v21.0
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
MESSAGING_PROVIDER=mock

# Live dealer copilot. Server only. Leave blank to keep live accounts in "AI provider not configured".
# Demo chat never reads these values. See docs/copilot.md.
# AI_PROVIDER: mock (default) | ollama | openai-compatible | huggingface | hf
# Ollama (local Qwen, no API key): AI_PROVIDER=ollama
#   AI_BASE_URL defaults to http://localhost:11434
#   AI_MODEL defaults to qwen3:8b
# Hugging Face: set AI_PROVIDER=huggingface, HF_TOKEN (or AI_API_KEY), and AI_MODEL.
# Example HF model id: Qwen/Qwen2.5-7B-Instruct — any chat model the Hugging Face router exposes.
# AI_BASE_URL defaults to https://router.huggingface.co/v1 for huggingface/hf.
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
HF_TOKEN=
AI_MODEL=
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1200
# Per agency per India calendar day. Blank uses the default of 300.
AI_DAILY_REQUEST_LIMIT=
# Per client IP per minute on /copilot/chat.
AI_CHAT_RATE_LIMIT_PER_MIN=10

# Notification delivery. No real email/SMS/push adapter ships yet.
# NOTIFICATION_SINK=local records deliveries in-process for development only (nothing is sent).
NOTIFICATION_SINK=
# Background delivery needs an SQS queue. Without it, the API reports "background delivery unavailable".
NOTIFICATION_QUEUE_URL=
AWS_REGION=
# Do not set AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY outside local. Deployed tasks use the ECS task role.

# Private media storage for tour videos. Without both values, live uploads show a setup state.
# Never set AWS access keys for deployed tasks; the ECS task role signs presigned URLs.
S3_BUCKET=
S3_REGION=

# Video reconstruction. No vendor adapter ships; see docs/reconstruction-provider.md.
# "mock" or "none" keeps the provider unconfigured. Any other name needs a key and a webhook secret.
RECONSTRUCTION_PROVIDER=mock
RECONSTRUCTION_API_KEY=
RECONSTRUCTION_BASE_URL=
RECONSTRUCTION_WEBHOOK_SECRET=
RECONSTRUCTION_MAX_BYTES=500000000
RECONSTRUCTION_RETENTION_DAYS=30
SQS_QUEUE_URL=
